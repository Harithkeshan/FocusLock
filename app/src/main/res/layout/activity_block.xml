<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_block.xml
  The full-screen block overlay shown when a restricted app is opened.
  File location: app/src/main/res/layout/activity_block.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="40dp"
    android:background="@color/surface_bg">

    <!-- Card Container for Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="32dp">

        <!-- Big hero icon -->
        <ImageView
            android:id="@+id/img_block_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_lock_closed"
            android:layout_marginBottom="16dp" />

        <!-- Main title e.g. "Daily limit reached" -->
        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily limit reached"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <!-- Subtitle e.g. "Come back tomorrow" or "Come back at 2:45 PM" -->
        <TextView
            android:id="@+id/txt_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Come back tomorrow"
            android:textSize="16sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="40dp" />

        <!-- Divider -->
        <View
            android:layout_width="48dp"
            android:layout_height="1dp"
            android:background="#252B36"
            android:layout_marginBottom="40dp" />

        <!-- Go to home screen button -->
        <TextView
            android:id="@+id/btn_go_home"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:text="Go to Home Screen"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#34d399"
            android:gravity="center"
            android:background="@drawable/bg_button_secondary" />

    </LinearLayout>

    <!-- Small note at bottom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FocusLock is keeping you on track"
        android:textSize="11sp"
        android:textColor="#252B36"
        android:gravity="center"
        android:layout_marginTop="32dp" />

</LinearLayout>