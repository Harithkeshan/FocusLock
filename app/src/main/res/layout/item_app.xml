<?xml version="1.0" encoding="utf-8"?>
<!--
  item_app.xml — single row in the app list
  File location: app/src/main/res/layout/item_app.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- App icon -->
    <ImageView
        android:id="@+id/img_app_icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="fitCenter" />

    <!-- App name -->
    <TextView
        android:id="@+id/txt_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- RESTRICTED badge — only visible when restriction is active -->
    <TextView
        android:id="@+id/txt_restricted_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ON"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#34d399"
        android:background="@drawable/bg_badge_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- Arrow indicator -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        android:layout_marginStart="8dp" />

</LinearLayout>