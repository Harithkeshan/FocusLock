<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#2e2e42"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset PIN Recovery"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Answer your recovery question to reset your PIN."
        android:textSize="13sp"
        android:textColor="#a1a1aa"
        android:layout_marginBottom="16dp" />

    <!-- Security Question Box -->
    <TextView
        android:id="@+id/txt_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What is your favorite book or movie?"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#d8b4fe"
        android:padding="16dp"
        android:background="@drawable/bg_banner_card"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edit_answer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Enter your Answer"
        android:textColorHint="#525266"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_search_bar"
        android:inputType="textAutoCorrect"
        android:singleLine="true"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txt_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incorrect answer. Try again."
        android:textSize="12sp"
        android:textColor="#ef4444"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/btn_verify_answer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Verify &amp; Reset PIN"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="8dp" />

</LinearLayout>
