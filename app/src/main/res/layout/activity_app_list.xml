<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_app_list.xml
  File location: app/src/main/res/layout/activity_app_list.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f">

    <!-- ── Header ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FocusLock"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#f0eeff" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap an app to set restrictions"
            android:textSize="13sp"
            android:textColor="#5a5475"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- ── MIUI Battery Optimization Warning Banner (Fix 1) ──────────
         Only visible on Xiaomi/POCO/Redmi devices where battery
         optimization is still active. Shown/hidden from AppListActivity. -->
    <LinearLayout
        android:id="@+id/banner_miui_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Warning title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ FocusLock may be killed by MIUI"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffcc44" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Xiaomi device's battery optimizer may stop FocusLock in the background, disabling all restrictions."
            android:textSize="11sp"
            android:textColor="#9990bb"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="12dp" />

        <!-- Two action buttons side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_disable_battery_opt"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Disable Battery Saver"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#c084fc"
                android:gravity="center"
                android:background="@drawable/bg_button_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_miui_autostart"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Enable Autostart"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Search bar ─────────────────────────────────────── -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_bar"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="16sp"
            android:layout_marginRight="8dp" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search apps..."
            android:textColor="#f0eeff"
            android:textSize="14sp"
            android:background="@null"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch" />

    </LinearLayout>

    <!-- ── Loading spinner ────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <!-- ── App list ───────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>