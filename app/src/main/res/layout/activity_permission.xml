<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_permission.xml
  File location: app/src/main/res/layout/activity_permission.xml
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:paddingTop="60dp">

        <!-- App icon / logo area -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/img_lock_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set up FocusLock"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Two permissions are needed to block apps and track your usage. Both are required."
            android:textSize="15sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="40dp"
            android:layout_marginHorizontal="16dp"/>

        <!-- ── Permission 1: Usage Access ──────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_usage_stats"
                    android:padding="12dp"
                    android:background="@drawable/bg_btn_circle"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usage Access"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tracks which app is open"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txt_usage_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not granted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f87171"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_status_not_granted"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btn_grant_usage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Grant Usage Access"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

        <!-- ── Permission 2: Draw Over Other Apps ──────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_overlay_window"
                    android:padding="12dp"
                    android:background="@drawable/bg_btn_circle"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Draw Over Other Apps"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shows the block screen on top"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txt_overlay_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not granted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f87171"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_status_not_granted"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btn_grant_overlay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Grant Draw Over Apps"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

        <!-- ── Permission 3: Accessibility ──────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_accessibility"
                    android:padding="12dp"
                    android:background="@drawable/bg_btn_circle"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessibility Access"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detects which app is open"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txt_accessibility_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not granted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f87171"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_status_not_granted"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btn_grant_accessibility"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Grant Accessibility Access"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

        <!-- ── Permission 4: Notifications ──────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_notification_bell"
                    android:padding="12dp"
                    android:background="@drawable/bg_btn_circle"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notification Access"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alerts when limits are approaching"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txt_notification_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not granted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f87171"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_status_not_granted"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btn_grant_notification"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Grant Notification Access"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>


        <!-- Continue button -->
        <TextView
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:alpha="0.4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Button unlocks when all permissions are granted"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>