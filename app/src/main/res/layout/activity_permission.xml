<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_permission.xml
  File location: app/src/main/res/layout/activity_permission.xml
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0f"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:paddingTop="60dp">

        <!-- App icon / logo area -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="64sp"
            android:layout_marginBottom="24dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set up FocusLock"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#f0eeff"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Two permissions are needed to block apps and track your usage. Both are required."
            android:textSize="14sp"
            android:textColor="#9990bb"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="40dp" />

        <!-- ── Permission 1: Usage Access ──────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#13131a"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usage Access"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#f0eeff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tracks which app is open"
                        android:textSize="12sp"
                        android:textColor="#5a5475"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txt_usage_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not granted"
                    android:textSize="12sp"
                    android:textColor="#f87171" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_grant_usage"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Grant Usage Access →"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#c084fc"
                android:gravity="center"
                android:background="#c084fc22"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- ── Permission 2: Draw Over Other Apps ──────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#13131a"
            android:padding="18dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪟"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Draw Over Other Apps"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#f0eeff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shows the block screen on top"
                        android:textSize="12sp"
                        android:textColor="#5a5475"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txt_overlay_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not granted"
                    android:textSize="12sp"
                    android:textColor="#f87171" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_grant_overlay"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Grant Draw Over Apps →"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#c084fc"
                android:gravity="center"
                android:background="#c084fc22"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Continue button -->
        <TextView
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue →"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:background="#a855f7"
            android:alpha="0.4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Button unlocks when both permissions are granted"
            android:textSize="11sp"
            android:textColor="#2a2a38"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>